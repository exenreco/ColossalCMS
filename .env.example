# Copy to .env.production locally, or add these keys to Render's environment.
# Never commit .env.production. Keep real credentials in server-side secrets.
CMS_PUBLIC_URL=https://your-site.onrender.com
CMS_DB_PROVIDER=mongodb
CMS_STORAGE_PROVIDER=gridfs
# Storage choices: r2, gridfs, local. GridFS uses the MongoDB credentials below.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/
MONGODB_DATABASE=ColossalCMS
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
MONGODB_GRIDFS_BUCKET=colossal_media
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=colossal-media
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FORCE_PATH_STYLE=false
# First-run setup: generate a random token with at least 32 characters.
# Open /setup and choose the administrator email and password.
CMS_SETUP_TOKEN=
# Scheduled MongoDB heartbeat: set in Vercel Production, then redeploy.
# Use a random secret of at least 32 characters; enable in Connections.
CRON_SECRET=
# Optional legacy/headless bootstrap instead of browser setup:
CMS_ADMIN_EMAIL=
# Generate a bcrypt cost-12 hash with pnpm password:hash (password read privately).
CMS_ADMIN_PASSWORD_HASH=
# For CMS_STORAGE_PROVIDER=local, set this to a persistent disk mount.
CMS_DATA_DIR=/var/data/colossal

# Local development signs in by default. Explicit loopback-only bypass:
# CMS_DEV_AUTH_BYPASS=true
