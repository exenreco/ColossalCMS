# Colossal CMS — complete supported environment reference
# Copy only the settings your deployment needs into .env.production or your
# hosting dashboard. Never commit real credentials. Commented settings are
# optional examples: uncomment them only when needed.
#
# Default MongoDB + GridFS setup: configure the six entries below.
# Optional plugin credentials are normally entered in the admin and stored
# encrypted in the database. Environment overrides take precedence and make
# those fields host-managed, including overrides set to an empty string.
# Do not uncomment every optional credential field.

# ---------------------------------------------------------------------------
# 1. Required site, administrator setup and encryption configuration
# ---------------------------------------------------------------------------
# Exact HTTPS origin, without a path/query/fragment. Required on Node/Vercel.
CMS_PUBLIC_URL=https://your-site.example.com
# First-run /setup token: 32–4096 characters. No default root password exists.
# Generate a random token; this does not reset an existing administrator.
CMS_SETUP_TOKEN=
# Persistent AES-256-GCM master key: 32 random bytes as 64 hexadecimal characters.
# Keep outside the database, preserve across deploys and back up separately.
# Generate locally (also suitable for a separately generated setup token):
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CMS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 2. Production database — choose MongoDB OR Cloudflare D1
# ---------------------------------------------------------------------------
# Explicit bootstrap selector; supported production values: mongodb, d1.
# Change this to d1 when using Cloudflare D1. Keep it outside the database.
CMS_DB_PROVIDER=mongodb

# MongoDB bootstrap credentials are required for a MongoDB database or GridFS.
# URL-encode reserved characters in the username/password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/
# Default: ColossalCMS. Preserve this override if your existing DB has another name.
MONGODB_DATABASE=ColossalCMS
# Default Node SRV/TXT DNS resolvers; at most four comma-separated IP addresses.
# Set to an empty string intentionally to use system DNS (for private DNS/VPCs).
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Cloudflare D1 through the Node/Vercel REST adapter:
# Set CMS_DB_PROVIDER=d1 and supply ALL THREE bootstrap credentials below.
# If GridFS is not used, omit the MongoDB URI/database entries above.
# Also select working storage: r2 requires its fields below; local requires a
# persistent Node disk. D1 with GridFS still requires MongoDB credentials.
# CMS_DB_PROVIDER=d1
# 32-character Cloudflare account ID.
# CLOUDFLARE_ACCOUNT_ID=
# D1 database UUID (36 characters).
# CLOUDFLARE_D1_DATABASE_ID=
# API token authorized to read/write the selected account's D1 database.
# CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# 3. Production storage — GridFS, R2/S3-compatible storage, or local files
# ---------------------------------------------------------------------------
# Default: gridfs. Supported values: gridfs, r2, local.
# Prefer the Connections page for encrypted storage configuration after setup.
# Environment overrides below remain supported. Restart/redeploy after changes;
# changing providers does not automatically migrate existing uploads.
# CMS_STORAGE_PROVIDER=gridfs

# MongoDB GridFS uses MONGODB_URI and MONGODB_DATABASE above.
# Default bucket name: colossal_media.
# MONGODB_GRIDFS_BUCKET=colossal_media

# R2/S3-compatible storage: select r2 and configure endpoint, bucket and both keys.
# Required for the initial R2 startup if not already saved in the database.
# CMS_STORAGE_PROVIDER=r2
# HTTPS endpoint origin without credentials, path, query or fragment.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=colossal-media
# Default: auto; other S3 providers may require a region such as us-east-1.
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Default: false. Set true for S3 providers requiring path-style bucket URLs.
# R2_FORCE_PATH_STYLE=false

# Local storage is supported on persistent Node hosting, not Vercel Functions.
# CMS_STORAGE_PROVIDER=local
# Application data directory: development defaults to .local; production local
# storage defaults to .production. Uploads are stored in its storage subfolder.
# Mount a persistent disk when using local production storage.
# CMS_DATA_DIR=/var/data/colossal

# ---------------------------------------------------------------------------
# 4. Optional MongoDB heartbeat authorization
# ---------------------------------------------------------------------------
# Configure the interval and enable heartbeat in Connections.
# Vercel/external scheduled requests require a separate random 32+ character secret.
# Vercel sends Authorization: Bearer <CRON_SECRET>. Keep after initial admin setup.
# Persistent Node scheduling does not require this key for its internal timer.
# CRON_SECRET=

# ---------------------------------------------------------------------------
# 5. Optional SMTP environment overrides
# ---------------------------------------------------------------------------
# Recommended: configure account credentials in Settings > SMTP; they are stored
# encrypted and can be updated without a redeploy on Node/Vercel.
# Host, port, TLS, sender, reply-to and enable state are database settings managed
# on that page, not SMTP_HOST/SMTP_PORT/etc. environment variables.
# SMTP_USERNAME=john@example.com
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# 6. Optional AI Assistant environment overrides
# ---------------------------------------------------------------------------
# Recommended: configure the selected provider on the AI Assistant plugin page.
# Credentials are encrypted; available models are discovered automatically.
# No model/model-ID environment variable or manual model setup is required.
# Only configure the provider keys actually used by your site.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Custom provider: trusted public HTTPS OpenAI-compatible API base URL.
# Must support GET /models and streaming POST /chat/completions.
# CUSTOM_AI_BASE_URL=https://api.example.com/v1
# CUSTOM_AI_API_KEY=

# ---------------------------------------------------------------------------
# 7. Optional legacy/headless administrator bootstrap
# ---------------------------------------------------------------------------
# Browser /setup is recommended. These values are an alternative for deployments
# initialized without it. Generate a bcrypt cost-12 hash using pnpm password:hash.
# Supply BOTH email and password hash; never put a plaintext admin password here.
# CMS_ADMIN_EMAIL=john@example.com
# CMS_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# 8. Runtime, development and testing
# ---------------------------------------------------------------------------
# Node production server port; default 3000. Hosts commonly supply PORT automatically.
# PORT=3000
# Local development server port; default 4200. Does not change production PORT.
# CMS_PORT=4200
# Conventional production runtime flag; the hosting platform may set it.
# NODE_ENV=production
# Render runtime selection; this application requires Node 24.x. Vercel uses its
# project Node version setting instead.
# NODE_VERSION=24
# Vercel sets VERCEL=1 automatically; do not set it on ordinary Node hosting.
# It enables Vercel-specific scheduling, storage restrictions and IP handling.
# VERCEL=1
# Loopback-only development authentication bypass; default false. Never use in production.
# Set development process variables before pnpm dev; the dev entrypoint does not
# load all of .env.production into process.env (the credential manager reads it).
# CMS_DEV_AUTH_BYPASS=false
# Optional Cypress spec filter for pnpm e2e; comma-separated paths are supported.
# CMS_E2E_SPEC=tests/e2e/ai-assistant.cy.mjs,tests/e2e/smtp-settings.cy.mjs

# Native Cloudflare Workers use DB, STORAGE and ASSETS runtime bindings, configured
# with Wrangler/Cloudflare; these are not dotenv strings. The supplied SMTP adapter
# is for Node/Vercel. See the hosting documentation for native Worker adapters.
# Credential precedence, migration and recovery: docs/developers/credentials.md
# Provider setup and local-data migration: docs/developers/production-connections.md
